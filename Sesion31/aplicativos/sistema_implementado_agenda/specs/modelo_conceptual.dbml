// @visual table=grupo x=0 y=40
Table grupo {
  id integer [pk]
  nombre varchar(255)
  descripcion varchar(255)
  color varchar(255)
}

// @visual table=contacto x=640 y=0
Table contacto {
  id integer [pk]
  nombre varchar(255)
  telefono varchar(255)
  correo varchar(255)
  es_favorito varchar(255)
  fecha_registro varchar(255)
}

// @visual table=contacto_grupo x=336 y=50
Table contacto_grupo {
  contacto_id integer [pk]
  grupo_id integer [pk]
  rol varchar(255)
}

// @relation-meta
// sourceLabel="está en"
// manyToManyTool="true"
Ref: contacto.id <? contacto_grupo.contacto_id

// @relation-meta
// sourceLabel="reúne"
// manyToManyTool="true"
Ref: grupo.id <? contacto_grupo.grupo_id
